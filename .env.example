# ---------------------------------------------------------------------------
# Before this goes live at the school, in this file on the server:
#
#   APP_ENV=production        APP_DEBUG=false
#     With APP_DEBUG on, a failure prints the stack trace, the SQL and these
#     credentials to whoever hit the page.
#
#   SESSION_ENCRYPT=true      SESSION_SECURE_COOKIE=true
#     Which means TLS in front of it. Even on the school's own network — a
#     signed-in session on this system can move money.
#
#   DB_USERNAME / DB_PASSWORD
#     Its own MySQL account with rights on prativa_inventory only, never root.
#
#   SEED_PASSWORD
#     Change it before seeding, and again after the last account is created.
#
# Also: nightly mysqldump off the machine, and keep the app off the public
# internet. See the audit notes in reference/ for the rest.
# ---------------------------------------------------------------------------

APP_NAME="Prativa Stock and Procurement"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prativa_inventory
DB_USERNAME=root
DB_PASSWORD=

# Password every seeded staff account starts with. Each is forced to change
# it on first sign-in.
SEED_PASSWORD=Prativa@2026

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# SESSION_SECURE_COOKIE=true   # switch on in production, behind TLS
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
